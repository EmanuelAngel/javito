{
	"name": "javito",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Herramientas de verificación del monorepo Javito.",
	"scripts": {
		"prepare": "husky",
		"format": "prettier --write \"**/*.{ts,js,svelte,json,yml,yaml}\"",
		"check:format": "prettier --check \"**/*.{ts,js,svelte,json,yml,yaml}\""
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1"
	}
}
